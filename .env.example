# Set the key for the provider selected with --provider.
ASSEMBLYAI_API_KEY=
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# Optional command defaults. Leave blank to use the normal defaults.
# PODSCRIPT_PROVIDER=elevenlabs
PODSCRIPT_PROVIDER=
PODSCRIPT_MODEL=
PODSCRIPT_COOKIES_FROM_BROWSER=
PODSCRIPT_JS_RUNTIME=
PODSCRIPT_OUTPUT=
PODSCRIPT_OUTPUT_DIR=

# Optional: enables local pyannote speaker diarization with --provider local.
HF_TOKEN=
